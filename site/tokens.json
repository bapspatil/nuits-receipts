{
  "_comment": "Source of truth for the site. Nothing else holds a hex. Run `bun run tokens` after any change; `bun run check` measures every claim below.",
  "color": {
    "ink": {
      "hex": "#0D3A36",
      "role": "Petrol ink. All primary text, rules, the focus ring.",
      "textOn": [
        "paper",
        "slip",
        "guilloche",
        "mint"
      ]
    },
    "inkSoft": {
      "hex": "#355650",
      "role": "Secondary text on paper and slips.",
      "textOn": [
        "paper",
        "slip"
      ]
    },
    "paper": {
      "hex": "#E6EFE9",
      "role": "Cheque-paper mint. The page surface.",
      "surface": true,
      "textOn": []
    },
    "slip": {
      "hex": "#FFFFFF",
      "role": "Receipt slips and plates. The only raised surface.",
      "surface": true,
      "textOn": [
        "ink"
      ]
    },
    "guilloche": {
      "hex": "#C2D8CB",
      "role": "The security-print line colour. A fill, never text.",
      "surface": true
    },
    "mint": {
      "hex": "#9FD3BC",

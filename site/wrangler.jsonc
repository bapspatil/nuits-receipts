{
  // Static assets, plus a tiny Worker that only runs for /media/* so the demo video
  // gets HTTP Range support (see worker.js). Every other path is served straight
  // from the assets without running the Worker. Serves the marketing site on the
  // Custom Domain receipts.nuits.net (the maintainer's domain: change or remove the route to deploy your own copy).
  // The app Worker (`nuits-receipts`) has more specific routes for
  // receipts.nuits.net/app and /app/*; Worker routes run before a Custom Domain,
  // so those paths never reach this Worker. No workers.dev URL, no previews.
  "name": "nuits-receipts-site",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "receipts.nuits.net", "custom_domain": true }],
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*"]
  }
}

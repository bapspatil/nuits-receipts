{
  "name": "nuits-receipts-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4321",
    "tokens": "node scripts/generate-tokens.mjs tokens.json --css src/styles/theme.css --wgsl src/shaders/palette.wgsl --check-shader 'src/shaders/*.wgsl,src/shaders/*.glsl'",
    "check": "node scripts/check-contrast.mjs tokens.json --quiet && node scripts/check-copy.mjs && node scripts/check-media-range.mjs",
    "art": "node scripts/changelog-art.mjs",
    "build": "bun run tokens && node scripts/check-contrast.mjs tokens.json --quiet && vite build && node scripts/check-copy.mjs && node scripts/check-weight.mjs",
    "preview": "vite preview --port 4321 --strictPort",
    "pile": "node scripts/shoot-pile.mjs",
    "svg": "node scripts/make-seal.mjs && npx --yes svgo@4 -q --config svgo.config.mjs -f src/assets/svg",
    "og": "node scripts/og.mjs",
    "fonts": "bash scripts/fonts.sh",
    "lighthouse": "bash scripts/lighthouse.sh",
    "screenshots": "node scripts/screenshots.mjs",
    "record": "node scripts/record.mjs",
    "preflight:launch": "node scripts/check-copy.mjs --production",
    "test": "bun test scripts/"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "gsap": "3.15.0",
    "media-chrome": "4.19.4",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "sharp": "0.34.5",
    "three": "0.186.1",
    "vite": "8.3.4"
  }
}

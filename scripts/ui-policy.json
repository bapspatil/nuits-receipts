{
  "fonts": ["Instrument Sans", "Bricolage", "DM Mono"],
  "fontSizes": [12, 13, 13.5, 15, 16, 18, 24, 30, 34],
  "typeRules": [
    { "selector": "h1", "sizes": [30, 34] },
    { "selector": "h2", "sizes": [18] },
    { "selector": "h3", "sizes": [15, 16] },
    { "selector": "button, [role=button], .btn", "sizes": [13, 15, 16] }
  ],
  "minControlGap": 8,
  "minControlInset": 8,
  "minLayoutGap": 8,
  "viewports": [
    { "width": 390, "height": 844 },
    { "width": 1440, "height": 900 }
  ],
  "colorSchemes": ["light"],
  "exceptions": [
    {
      "selector": ".vh, .skip:not(:focus)",
      "rules": ["content-clipping", "text-contrast"],
      "reason": "Visually hidden on purpose."
    },
    {
      "selector": "nav.tabs a *",
      "rules": ["text-contrast"],
      "reason": "The phone tab bar is glass over whatever scrolls under it, which axe cannot see through. Its labels and counts are measured flat over the darkest and lightest backdrop instead (glassOver* in src/tokens.json, scripts/app-tokens.test.ts)."
    },
    {
      "selector": "details:not([open]) *",
      "rules": ["control-inset", "text-contrast"],
      "reason": "Closed disclosure content has no box."
    }
  ]
}

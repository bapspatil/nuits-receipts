{
  "_comment": "Direction B, Swiss workbench. Mirrors the hex values in tokens.css. Every text pair the screens use is claimed here.",
  "color": {
    "page": {
      "hex": "#F5F6F7",
      "role": "--surface-page",
      "surface": true
    },
    "raised": {
      "hex": "#FFFFFF",
      "role": "--surface-raised",
      "surface": true
    },
    "sunken": {
      "hex": "#ECEEF0",
      "role": "--surface-sunken, the document panel and table heads",
      "surface": true
    },
    "accentQuiet": {
      "hex": "#E2ECEA",
      "role": "Active nav and selected row fill",
      "surface": true
    },
    "dangerSurface": {
      "hex": "#FCEBEA",
      "role": "--danger-surface",
      "surface": true
    },
    "successSurface": {
      "hex": "#E6F2EA",
      "role": "--success-surface",
      "surface": true
    },
    "text": {
      "hex": "#101418",
      "role": "--text",
      "textOn": [
        "page",
        "raised",
        "sunken",
        "accentQuiet",
        "dangerSurface",
        "successSurface"
      ]
    },
    "muted": {
      "hex": "#4B5560",
      "role": "--text-muted",
      "textOn": [
        "page",
        "raised",
        "sunken",
        "accentQuiet",
        "dangerSurface",
        "successSurface"
      ]
    },
    "accent": {
      "hex": "#0D3A36",
      "role": "--accent, links, active nav, primary fill, focus ring",
      "surface": true,
      "textOn": [
        "page",
        "raised",
        "sunken",
        "accentQuiet"
      ],
      "indicatorOn": [
        "page",
        "raised",
        "sunken",
        "dangerSurface",
        "successSurface"
      ]
    },
    "accentHover": {
      "hex": "#072522",
      "role": "--accent-hover",
      "surface": true
    },
    "onAccent": {
      "hex": "#FFFFFF",
      "role": "--text-on-accent",
      "textOn": [
        "accent",
        "accentHover",
        "danger"
      ]
    },
    "danger": {
      "hex": "#B3261E",
      "role": "--danger, Needs you and Missing, always with words",
      "textOn": [
        "page",
        "raised",
        "sunken",
        "dangerSurface"
      ],
      "indicatorOn": [
        "page",
        "raised",
        "dangerSurface"
      ],
      "surface": true
    },
    "success": {
      "hex": "#1E6B3C",
      "role": "--success, Matched and Ready, always with words",
      "textOn": [
        "page",
        "raised",
        "sunken",
        "successSurface"
      ]
    },
    "borderStrong": {
      "hex": "#7D8691",
      "role": "--border-strong, input outlines",
      "indicatorOn": [
        "page",
        "raised"
      ]
    },
    "border": {
      "hex": "#D6DADF",
      "role": "--border, hairline rules. Decoration only."
    }
  }
}

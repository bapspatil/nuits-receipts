{
  "_comment": "Source of truth for the app's CSS custom properties. Run `bun run tokens` after any change; scripts/app-tokens.test.ts fails when src/tokens.ts is stale, and measures every contrast claim below with site/scripts/check-contrast.mjs. Three layers: primitives (color, font, text, space, radius, shadow), semantic (what a value means) and component (what one part of the UI uses). Values are direction B, Swiss workbench: a cool near-white page, white tables, hairline rules, and the brand ink as the only accent.",
  "color": {
    "grey50": {
      "hex": "#F5F6F7",
      "role": "The page: a cool near-white.",
      "surface": true
    },
    "grey0": {
      "hex": "#FFFFFF",
      "role": "Tables, fields, cards and text on the ink fill. The raised surface.",
      "surface": true,
      "textOn": ["petrol900", "petrol950", "red700"]
    },
    "grey100": {
      "hex": "#ECEEF0",
      "role": "The sunken surface: the document panel and table heads.",
      "surface": true
    },
    "petrol50": {
      "hex": "#E2ECEA",
      "role": "The active nav item and a selected row.",
      "surface": true
    },
    "red50": {
      "hex": "#FCEBEA",
      "role": "The pale red behind an alert and a flagged line.",
      "surface": true
    },
    "green50": {
      "hex": "#E6F2EA",
      "role": "The pale green behind a done mark.",
      "surface": true
    },
    "grey950": {
      "hex": "#101418",
      "role": "Body text.",
      "textOn": ["grey50", "grey0", "grey100", "petrol50", "red50", "green50"]
    },
    "grey700": {
      "hex": "#4B5560",
      "role": "Secondary text and small-caps column heads.",
      "textOn": ["grey50", "grey0", "grey100", "petrol50", "red50", "green50"]
    },
    "petrol900": {
      "hex": "#0D3A36",
      "role": "The brand ink. Links, the active nav item, the primary fill, the focus ring.",
      "surface": true,
      "textOn": ["grey50", "grey0", "grey100", "petrol50"],
      "indicatorOn": ["grey50", "grey0", "grey100", "red50", "green50"]
    },
    "petrol950": {
      "hex": "#072522",
      "role": "The primary fill while hovered.",
      "surface": true
    },
    "red700": {
      "hex": "#B3261E",
      "role": "Needs you and missing. Always with words.",
      "surface": true,
      "textOn": ["grey50", "grey0", "grey100", "red50"],
      "indicatorOn": ["grey50", "grey0", "red50"]
    },
    "green800": {
      "hex": "#1E6B3C",
      "role": "Matched and ready. Always with words.",
      "textOn": ["grey50", "grey0", "grey100", "green50"]
    },
    "grey500": {
      "hex": "#7D8691",
      "role": "Input outlines. Indicators only, never text.",
      "indicatorOn": ["grey50", "grey0"]
    },
    "grey200": {
      "hex": "#D6DADF",
      "role": "Hairline rules. Decoration only."
    },
    "paper": {
      "hex": "#E6EFE9",
      "role": "The tab icon background, as on the site. Never a UI surface."
    }
  },

    "paper50": {
      "hex": "#F3EDE2",
      "role": "The page, under a 5% grain.",
      "surface": true
    },
    "paper0": {
      "hex": "#FBF8F2",
      "role": "The sheet: grouped lists, cards, folds. Also text on the petrol fill, and the glass tint.",
      "surface": true,
      "textOn": ["petrol900", "petrol950", "red700"],
      "indicatorOn": ["petrol900"]
    },
    "paperField": {
      "hex": "#FFFDF8",
      "role": "Fields, checkboxes and secondary buttons.",
      "surface": true
    },
    "paper200": {
      "hex": "#E6DDCC",
      "role": "The sunken surface: the document panel, the segmented control's track.",
      "surface": true
    },
    "petrol50": {
      "hex": "#DCE6DF",
      "role": "A selected row, the current sidebar item and the current chip.",
      "surface": true
    },
    "red50": {
      "hex": "#F5DCD5",
      "role": "The pale red behind an error.",
      "surface": true
    },
    "green50": {
      "hex": "#E2ECD9",
      "role": "The pale green behind a done stamp.",
      "surface": true
    },
    "amber50": {
      "hex": "#F6E3C1",
      "role": "The pale amber behind a warning stamp.",
      "surface": true

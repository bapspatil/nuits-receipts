  "glass": {
    "_comment": "Navigation and floating controls only; content stays solid. The tint takes the lowest alpha, in steps of .01, at which ink, muted, accent and success text all reach 4.5:1 over every colour in `under` (scripts/app-tokens.test.ts recomputes it). Measured flat, before blur: blur only averages the backdrop towards its mean, so the flat case bounds the real one.",
    "tint": "paper0",
    "alpha": 0.85,
    "labels": ["ink950", "ink700", "petrol900", "green800"],
    "under": ["petrol950", "ink950", "petrol900", "paperField", "paper50"]
  },
  "font": {
    "display": "\"Bricolage\",\"Arial Narrow\",system-ui,sans-serif",

      "textOn": [
        "paper50",
        "paper0",
        "paperField",
        "paper200",
        "petrol50",
        "glassOverDarkest",
        "glassOverInk",
        "glassOverLightest",
        "glassOverTrack"
      ],
      "indicatorOn": ["paper50", "paper0", "paper200", "petrol50", "red50", "green50", "glassOverDarkest"]
    },
    "petrol950": {
      "hex": "#072522",
      "role": "The primary fill while hovered.",
      "surface": true
    },
    "red700": {
      "hex": "#A12820",
      "role": "Errors and permanent delete only. Always with words.",
      "surface": true,
      "textOn": ["paper50", "paper0", "red50"],
      "indicatorOn": ["paper50", "paper0", "paperField", "red50"]
    },
    "green800": {
      "hex": "#2E6A3C",
      "role": "Done: matched, ready, sent, and the Undo banner. Always with words.",

{
  // Static assets only: no `main`, so no Worker script runs. Serves the docs at
  // receipts.nuits.net/docs (the maintainer's domain: change or remove the routes to deploy your own copy). The marketing site (`nuits-receipts-site`) owns the
  // Custom Domain root and the app (`nuits-receipts`) owns /app; this Worker's
  // more specific /docs routes run before the Custom Domain.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuits-receipts-docs",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "receipts.nuits.net/docs", "zone_name": "nuits.net" },
    { "pattern": "receipts.nuits.net/docs/*", "zone_name": "nuits.net" }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  }
}

{
  "name": "nuits-receipts-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/nest-under-base.mjs && node scripts/check-copy.mjs",
    "preview": "wrangler dev --port 4322",
    "typecheck": "astro check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "predeploy": "astro check && bun run build",
    "deploy": "wrangler deploy",
    "check:copy": "node scripts/check-copy.mjs",
    "preflight:launch": "node scripts/check-copy.mjs --production"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "^0.19.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "7.3.1",
    "clsx": "^2.1.1",
    "satori": "^0.26.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/language-server": "2.16.13",
    "@tailwindcss/vite": "^4.1.4",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.95.0"
  }
}

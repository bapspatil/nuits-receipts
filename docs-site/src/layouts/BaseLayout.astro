---
import "@fontsource-variable/jetbrains-mono";
// The body and heading fonts start downloading with the page instead of after
// the CSS. ?url gives hashed, base-aware (/docs) paths.
import instrumentSans from "../assets/fonts/instrument-sans.woff2?url";
import bricolage from "../assets/fonts/bricolage.woff2?url";
import "../styles/globals.css";
import "../styles/prose.css";
import "../styles/chrome.css";
import { ClientRouter } from "astro:transitions";
import { config } from "virtual:nimbus/config";
import {
  getCollectionLlmsUrl,
  getVersionStatus,
  withBase,
} from "@cloudflare/nimbus-docs/runtime";
import AgentDirective from "@/components/AgentDirective.astro";
import { SearchDialog } from "@/components/ui/search";
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import Footer from "@/components/Footer.astro";
import WebMCP from "@/components/WebMCP.astro";
import type { BasePageProps } from "@cloudflare/nimbus-docs/types";

type Props = BasePageProps;

const {
  title,
  description,
  noindex,
  markdownUrl,
  socialImage,
  socialImageSize,
  lastUpdated,
  head: pageHead = [],
  collection,
  entryId,
  apiVersion,
  coordinate,
} = Astro.props;

const lang = config.locale ?? "en";
// Per-page agent-index pointer. For pages in non-primary or version
// collections, this resolves to `/<prefix>/llms.txt` (e.g. `/v0/llms.txt`
// for a v0 docs page, `/blog/llms.txt` for a blog post). Falls back to
// the root `/llms.txt` when no collection is provided.
// Hidden-version pages don't advertise an agent index (the per-version
// llms.txt isn't emitted for them); suppress the AgentDirective entirely.
const versionStatusKey =
  apiVersion && collection ? `${collection}@${apiVersion}` : collection;
const versionStatus = versionStatusKey
  ? await getVersionStatus(versionStatusKey)
  : null;
const isHiddenVersion = versionStatus?.isHidden === true;
const llmsIndexPath = collection
  ? await getCollectionLlmsUrl(collection)
  : "/llms.txt";
const baseUrl = import.meta.env.BASE_URL;
const basedLlmsUrl = withBase(llmsIndexPath, baseUrl);
const llmsUrl = Astro.site
  ? new URL(basedLlmsUrl, Astro.site).href
  : basedLlmsUrl;
const basedMarkdownUrl = markdownUrl ? withBase(markdownUrl, baseUrl) : undefined;
const resolvedMarkdownUrl =
  basedMarkdownUrl && Astro.site
    ? new URL(basedMarkdownUrl, Astro.site).href
    : basedMarkdownUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={instrumentSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <WebMCP />

    <script is:inline>
      (() => {
        const KEY = "ui-mode";
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        // A choice storage refused, kept until the page unloads.
        let unsaved = null;

        const readPref = () => {
          if (unsaved) return unsaved;
          try {
            const v = localStorage.getItem(KEY);
            return v === "dark" || v === "light" ? v : null;
          } catch {
            return null;
          }
        };

        const resolveMode = () => readPref() ?? (media.matches ? "dark" : "light");

        const applyTheme = () => {
          const root = document.documentElement;
          const mode = resolveMode();
          if (mode === "dark") root.setAttribute("data-mode", "dark");
          else root.removeAttribute("data-mode");
          root.style.colorScheme = mode;
          document.querySelectorAll("[data-nb-theme-toggle]").forEach((b) => {
            b.setAttribute("data-nb-state", mode);
            b.setAttribute("aria-pressed", String(mode === "dark"));
          });
        };

        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
        media.addEventListener("change", () => {
          if (!readPref()) applyTheme();
        });
        window.addEventListener("storage", (e) => {
          if (e.key === KEY) applyTheme();
        });

        // The toggle passes a mode only when storage refused it.
        window.__nbApplyTheme = (mode) => {
          if (mode === "dark" || mode === "light") unsaved = mode;
          applyTheme();
        };
      })();
    </script>

    <NimbusHead
      title={title}
      description={description}
      noindex={noindex}
      markdownUrl={markdownUrl}
      socialImage={socialImage}
      socialImageSize={socialImageSize}
      lastUpdated={lastUpdated}
      head={pageHead}
      collection={collection}
      entryId={entryId}
      apiVersion={apiVersion}
      coordinate={coordinate}
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-3 focus:z-100 focus:inline-flex focus:min-h-11 focus:items-center focus:rounded-full focus:bg-primary focus:px-4 focus:text-sm focus:font-semibold focus:text-primary-foreground focus:no-underline"
    >
      Skip to content
    </a>
    {!isHiddenVersion && (
      <AgentDirective markdownUrl={resolvedMarkdownUrl ?? null} llmsUrl={llmsUrl} />
    )}
    <slot />
    <Footer />
    {config.search !== false && <SearchDialog />}

    {/* Escape hides a header tooltip until the pointer or focus moves on.
        Numeric table cells (amounts, counts) are set right-aligned, like a
        column of figures on a receipt; the check is the one lintapple uses. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const tipsOn = () => root.removeAttribute("data-tips-off");
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") root.setAttribute("data-tips-off", "");
        });
        document.addEventListener("pointermove", tipsOn, { passive: true });
        document.addEventListener("focusin", tipsOn);
        const markNumbers = () => {
          for (const td of document.querySelectorAll(".docs-content td")) {
            const text = td.textContent.trim();
            if (/\d/.test(text) && /^[+−-]?[\d\s,.:%$€£]+$/.test(text)) td.setAttribute("data-numeric", "");
          }
        };
        markNumbers();
        document.addEventListener("astro:after-swap", markNumbers);
      })();
    </script>
    <script>
      import { codeCopy, headingAnchors } from "@cloudflare/nimbus-docs/client";
      codeCopy();
      headingAnchors();
    </script>
  </body>
</html>

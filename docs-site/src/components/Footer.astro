---
/* Site footer, on every page via BaseLayout: the receipt's stub, as on the
   marketing site (site/src/partials/footer.html), with its wording. The
   trader line is checked at build time, so keep its text exactly as is. */
import { config } from "virtual:nimbus/config";
import Logo from "./Logo.astro";
---
<footer class="nb-stub" aria-label="Site footer">
  <div class="nb-stub-tear" aria-hidden="true"></div>
  <div class="nb-stub-inner">
    <div class="nb-stub-head">
      <p class="nb-stub-name" aria-hidden="true"><Logo class="nb-stub-mark" />Nuits Receipts</p>
      <nav aria-label="Footer" class="nb-stub-nav">
        <ul>
          <li><a href="https://receipts.nuits.net/">Home</a></li>
          <li><a href="https://receipts.nuits.net/privacy/">Privacy notice</a></li>
          {config.github && <li><a href={config.github}>GitHub</a></li>}
        </ul>
      </nav>
    </div>
    <div class="nb-stub-print">
      <p><strong>Nuits Receipts organises receipts and prepares a CSV for your accountant. It is not tax, VAT or accounting advice.</strong></p>
      <p class="trader">Nuits, sole trader (Bapusaheb Shankaragouda Patil), Business ID 3584845-8, Helsinki, <a href="mailto:hi@brandnuits.com">hi@brandnuits.com</a></p>
      <p>Open source under the <a href="https://www.apache.org/licenses/LICENSE-2.0">Apache License 2.0</a>.</p>
      <p>Holvi and other bank names are trademarks of their owners. Nuits Receipts is not affiliated with or endorsed by them.</p>
      <p>Cloudflare, the Cloudflare logo, and Cloudflare Workers are trademarks and/or registered trademarks of Cloudflare, Inc. in the United States and other jurisdictions.</p>
    </div>
  </div>
</footer>

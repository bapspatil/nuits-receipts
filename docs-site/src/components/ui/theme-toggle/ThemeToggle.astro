---
/**
 * ThemeToggle, light/dark switcher. Persists to localStorage; theme
 * applies to `<html data-mode="dark">` via the inline script in BaseLayout
 * (no FOUC).
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {}

const { class: className, ...attrs } = Astro.props;
---

<span class={cn("nb-tipped", className)}>
  <button
    data-slot="theme-toggle"
    type="button"
    data-nb-theme-toggle
    class="nb-pill nb-pill-icon group"
    {...attrs}
    aria-label="Dark mode"
    aria-describedby="nb-tip-theme"
    aria-pressed="false"
    data-nb-state="light"
  >
    <Icon name="ph:sun" class="nb-pill-glyph hidden group-data-[nb-state=dark]:block" />
    <Icon name="ph:moon" class="nb-pill-glyph group-data-[nb-state=dark]:hidden" />
  </button>
  <span class="nb-tip" role="tooltip" id="nb-tip-theme">Dark mode</span>
</span>

<script>
  import "./theme-toggle.client";
</script>

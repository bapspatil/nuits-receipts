---
/** Button that opens the search dialog. Cmd+K on macOS, Ctrl+K elsewhere. */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
---

<span class="nb-tipped">
  <button
    data-slot="search-trigger"
    data-search-trigger
    type="button"
    class="nb-pill nb-pill-search"
    aria-keyshortcuts="Control+K"
    aria-label="Search"
    aria-describedby="nb-tip-search"
  >
    <Icon name="ph:magnifying-glass" class="nb-pill-glyph" />
    <span class="nb-pill-label">Search</span>
  </button>
  <span class="nb-tip" role="tooltip" id="nb-tip-search">Search the docs, <kbd dir="ltr" data-shortcut>Ctrl K</kbd></span>
</span>

<script>
  import "./search-trigger.client";
</script>

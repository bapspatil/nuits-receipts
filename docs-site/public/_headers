# Hashed build files never change, so browsers keep them for a year without
# asking again. Hosts that don't read _headers ignore this file.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers on every docs page, matching the app and the marketing site.
# The Content-Security-Policy allows this site's own scripts, the two inline
# scripts the theme and sidebar need (by hash, filled in by
# scripts/csp-hashes.mjs after the build) and WebAssembly for the search index.
# Nothing is loaded from another site, except the script Cloudflare itself adds to pages
# when Web Analytics is switched on for the domain (static.cloudflareinsights.com).
# scripts/nest-under-base.mjs turns the
# paths below into /docs/... paths.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com __INLINE_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
